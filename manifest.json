{
  "id": "violation-tracking",
  "contexts": [
    "household",
    "shared_space"
  ],
  "name": "Violation Tracking",
  "version": "1.1.0",
  "description": "Board issues CC&R violation notices to units; homeowners acknowledge, respond, or dispute; board tracks through resolution or escalation.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": [
    "hoa",
    "violations",
    "ccr",
    "compliance",
    "board"
  ],
  "data_access": {
    "reads": [
      "family.members",
      "family.groups"
    ],
    "writes": []
  },
  "exports": [
    "pending_violations"
  ],
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": true
  },
  "storage": "db",
  "db_plaintext_columns": [
    "cure_deadline"
  ],
  "agenda": {
    "kind": "reminder",
    "label": "Cure deadline",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, COALESCE(NULLIF(description, ''), 'Violation notice') AS title, cure_deadline AS when_at, unit_id AS member_id, category AS subtitle FROM app_violation_tracking__violations WHERE cure_deadline = :today AND status = 'open' ORDER BY created_at LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_violation_tracking__violations WHERE status = 'open' LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "open violations",
      "severity": "warn"
    }
  },
  "row_policies": {
    "settings": {
      "kind": "app_config"
    },
    "violations": {
      "kind": "owner_only",
      "member_column": "unit_id",
      "adults_bypass": false,
      "member_can_update": false,
      "insert_privileged_only": true,
      "delete_privileged_only": true,
      "privileged_groups": [
        {
          "settings_table": "settings",
          "settings_key": "board_group_id"
        }
      ],
      "audit_writes": true
    },
    "activity": {
      "kind": "inherit_visibility",
      "fk_column": "violation_id",
      "parent_table": "violations",
      "writer_column": "actor_id",
      "audit_writes": true
    }
  },
  "delete_file_columns": {
    "violations": [
      "photo_file_id"
    ]
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": [
      "board_group_id"
    ]
  },
  "notification_acls": {
    "send": {
      "require_group_setting": {
        "settings_table": "settings",
        "settings_key": "board_group_id"
      }
    }
  },
  "export_acls": {
    "pending_violations": {
      "require_group_setting": {
        "settings_table": "settings",
        "settings_key": "board_group_id"
      }
    }
  },
  "store_acls": {
    "pending_violations": {
      "read": {
        "require_group_setting": {
          "settings_table": "settings",
          "settings_key": "board_group_id"
        }
      },
      "write": {
        "require_group_setting": {
          "settings_table": "settings",
          "settings_key": "board_group_id"
        }
      }
    }
  },
  "member_references": {
    "violations": [
      {
        "column": "unit_id",
        "on_removed": "keep"
      },
      {
        "column": "issued_by",
        "on_removed": "keep"
      }
    ],
    "activity": {
      "column": "actor_id",
      "on_removed": "keep"
    }
  },
  "kiosk": "never",
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "nav": {
    "label": "Violations"
  },
  "icon": "\u26a0\ufe0f"
}
